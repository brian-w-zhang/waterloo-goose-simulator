{
  "name": "waterloo-goose-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pipeline": ".venv/bin/python -m pipeline.fetch && .venv/bin/python -m pipeline.build",
    "verify:fast": ".venv/bin/python -m tools.verify.verify fast",
    "verify": ".venv/bin/python -m tools.verify.verify full",
    "verify:geometry": ".venv/bin/python -m pipeline.validate.run /tmp/wgs-geometry",
    "test:py": ".venv/bin/python -m pytest -q pipeline",
    "verify:render": ".venv/bin/python -m tools.verify.verify render",
    "art": "blender -b --python-exit-code 1 -P art/build.py --"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recast-navigation": "0.44.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
